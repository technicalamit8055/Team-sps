VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# --- WhatsApp receipts (Baileys, server-side) ---
# The Baileys server holds a live WebSocket and writes session files to disk,
# so it CANNOT run on Vercel (serverless = stateless + ephemeral disk). Deploy
# server/ to Railway / Render / Fly / a VPS, then point the frontend at it.
# See docs/WHATSAPP_RECEIPTS.md.

# --- Frontend (set these in the Vercel dashboard) ---
# Leave blank in dev: Vite proxies /api/whatsapp to localhost:8787.
# In production set the public URL of the deployed server, no trailing slash:
#   VITE_WHATSAPP_API_URL=https://your-app.up.railway.app
# NOTE: Vite inlines these at BUILD time — changing them needs a REDEPLOY.
VITE_WHATSAPP_API_URL=
# Must equal WHATSAPP_API_TOKEN below. This ships in the JS bundle, so it only
# stops drive-by abuse, not a determined user who reads the bundle.
VITE_WHATSAPP_API_TOKEN=

# --- Server (set these on Railway/Render, NOT on Vercel) ---
# Cloud hosts inject PORT themselves; this is only the local fallback.
WHATSAPP_SERVER_PORT=8787
# Point at a PERSISTENT VOLUME in the cloud (e.g. /data/whatsapp_auth),
# otherwise the session is wiped on every redeploy and re-scanning is required.
WHATSAPP_AUTH_DIR=./whatsapp_auth
WHATSAPP_COUNTRY_CODE=91
WHATSAPP_DEFAULT_PHONE=
WHATSAPP_BUSINESS_NAME=
WHATSAPP_MIN_GAP_MS=2500
# REQUIRED in production — without it anyone can send from your WhatsApp
# account. Generate with: openssl rand -hex 32
WHATSAPP_API_TOKEN=
# Comma-separated exact origins, e.g. https://team-sps.vercel.app
WHATSAPP_ALLOWED_ORIGINS=
# Comma-separated patterns for Vercel preview URLs; * matches one label:
#   https://team-sps-*.vercel.app
WHATSAPP_ALLOWED_ORIGIN_PATTERNS=
